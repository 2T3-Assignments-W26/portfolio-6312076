function errorHandlerBureau_MIO(a, b, c) {

	var pathNameLower = document.location.pathname.toLowerCase();
	var path = document.location.pathname.substr(0, 5);

	if (pathNameLower.indexOf("/messagerieinterneomnivox/") >= 0)
		pathNameLower = "MessagerieInterneOmnivox"
	else
		pathNameLower = "Mio2"

	path = '/WebApplication/Module.MIOE/JSErrorHandler.ashx';

	/*if (path.toLowerCase() == "/intr")
		path = "/Intr/Module/" + pathNameLower + "/JSErrorHandler.ashx";
	else
		path = path + "/Net/" + pathNameLower + "/JSErrorHandler.ashx";*/

	return errorHandler(a, b, c, true, path) 
}

function EnterHandler(obj, evenement)
{
	if (evenement.keyCode+"" == "13")
		if(GE(msgConf).className != "hideConfirm")
			eval(postback_url);
}//EnterHandler


function NavigateTo(url, frameId)
{
	switch (frameId)
	{
		case "frListeMio":
			{
				if (window.top.frames[2].window.self.frames.length == 2)
					window.top.frames[2].window.self.frames[0].location = url;
				else
					window.top.frames[2].location = url.substring(url.indexOf("?"), url.length);
			}
			break;
		case "frMilieu":
		default:
			{
				window.top.frames[2].window.location = url;
			}
			break;
	}

}

function BloqueContenu(objPopUp)
{
	SwitchPreventClickInFrames(objPopUp,true);
}
function RestoreContenu(objPopUp)
{
	SwitchPreventClickInFrames(objPopUp,false);
}

/**
 * Permet d'envoyer un MIO
 */
function MioTo(idContact)
{
    var idxPosUrl = window.top.location.toLowerCase().indexOf('messagerieinterneomnivox') + 24;
	window.top.location = window.top.location.substr(0, idxPosUrl) + "/Default.aspx?ActionDefaut=EcrireMio&IdContact=" + idContact
}

