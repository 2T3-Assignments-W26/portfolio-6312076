/// <reference path="SelectionIndividu.asmx" />

(function () {
	if (!window.WebApplication) { window.WebApplication = {}; }
	if (!window.WebApplication.Commun) { window.WebApplication.Commun = {}; }
	if (!window.WebApplication.Commun.SelectionIndividu) { window.WebApplication.Commun.SelectionIndividu = {}; }


	window.WebApplication.Commun.SelectionIndividu.PopupWorker = function () {
		var self = {};


		/**
		* Cette méthode permet de lancer le popup de recherche
		*/
		var _functionCallbackPoupFerme = null;
		var _IdBoutonRecherche = null;



		self.ReinitialiserRecherche = function (objChampHiddenRecherche, strOidCreateur) {

		};


		self.OuvrirRecherche = function (objChampHiddenRecherche, strModeRecherche, strOidCreateur, strAnSession, strMotCleRecherche, fnCallbackPopupFerme, maxWidth, maxHeight) {
			OuvrirRecherche(intIdRechercheIndividu, strModeRecherche, strOidCreateur, strAnSession, objChampHiddenRecherche.id, strMotCleRecherche, fnCallbackPopupFerme, maxWidth, maxHeight, "");
		}; //OuvrirRecherche

		self.OuvrirRecherche = function (objChampHiddenRecherche, strModeRecherche, strOidCreateur, strAnSession, strMotCleRecherche, fnCallbackPopupFerme, maxWidth, maxHeight, strTitreRegroupementContact) {
			var intIdRechercheIndividu = objChampHiddenRecherche.value;
			var objFenetre;
			if (intIdRechercheIndividu == null || intIdRechercheIndividu.length == 0) {
				intIdRechercheIndividu = -1;
			}
			if (strTitreRegroupementContact == "") {
				objFenetre = self.OuvrirRecherche_Popup(intIdRechercheIndividu, strModeRecherche, strOidCreateur, strAnSession, objChampHiddenRecherche.id, strMotCleRecherche, fnCallbackPopupFerme, maxWidth, maxHeight);
			} else {
				objFenetre = self.OuvrirRecherche_Popup(intIdRechercheIndividu, strModeRecherche, strOidCreateur, strAnSession, objChampHiddenRecherche.id, strMotCleRecherche, fnCallbackPopupFerme, maxWidth, maxHeight, strTitreRegroupementContact);
			}
			if (fnCallbackPopupFerme) {
				_functionCallbackPoupFerme = fnCallbackPopupFerme;
			}

			return objFenetre;
		}


		self.SelectionIndividu_CallbackPopupFerme = function () {
			if (_functionCallbackPoupFerme) {
				_functionCallbackPoupFerme();
			}
		}; //CallbackPopupFerme

		self.OuvrirRecherche_Popup = function (intIdRechercheIndividu, strModeRecherche, strOidCreateur, strAnSession, strChampHiddenRecherche, strMotCleRecherche, fnCallbackPopupFerme, maxWidth, maxHeight) {
			OuvrirRecherche_Popup(intIdRechercheIndividu, strModeRecherche, strOidCreateur, strAnSession, strChampHiddenRecherche, strMotCleRecherche, fnCallbackPopupFerme, maxWidth, maxHeight, "");
		}

		self.OuvrirRecherche_Popup = function (intIdRechercheIndividu, strModeRecherche, strOidCreateur, strAnSession, strChampHiddenRecherche, strMotCleRecherche, fnCallbackPopupFerme, maxWidth, maxHeight, strTitreRegroupementContact) {
			strURL = "/WebApplication/Authentification/Acces/Omnivox/Commun.SelectionIndividu?lk=";
			strURL += "/WebApplication/Commun.SelectionIndividu/Prive/?eModeRecherche=" + strModeRecherche + "%26OidCreateur=" + strOidCreateur + "%26IdRechercheIndividu=" + intIdRechercheIndividu + "%26strChampHiddenRecherche=" + strChampHiddenRecherche;
			if (strMotCleRecherche) {
				// Jonathan Larivée
				// [B31750] - MIO - Recherche rapide d'un nom avec accent
				// Ok ça peut sembler vraiment fucked up mais il faut faire un escape ET un encoreURIComponent pour que le paramètre qui contient des accents soit correct rendu dans notre méthode MVC
				strURL += "%26MotCleRecherche=" + escape(encodeURIComponent(strMotCleRecherche));
			}
			if (strAnSession) {
				strURL += "%26AnSession=" + escape(strAnSession);
			}
			if (strTitreRegroupementContact) {
				strURL += "%26strTitreRegroupementContact=" + escape(encodeURIComponent(strTitreRegroupementContact));
			}
			strNom = "SelectionIndividu_" + strModeRecherche;


			//Ouvre une fenêtre CENTRÉE selon les options passées en paramètres
			//strURL = adresse de la page à ouvrir
			//strNom = Nom de la fenêtre

			var iPosX;
			var iPosY;
			var wnd;


			/**
			* On set la taille par défaut
			*/
			var pxWidth = 900;
			var pxHeigth = 600;

			try {

				if (maxWidth < pxWidth)
					pxWidth = Math.floor(maxWidth * 0.95);

				if (maxHeight < pxHeigth)
					pxHeigth = Math.floor(maxHeight * 0.92);
			}
			catch (e) {
				//En IE6 il semble que le floor ne fonctionne pas!
				pxWidth = maxWidth - 80;
				pxHeigth = maxHeight - 100;
			}

			var browser = navigator.appName;
			var version = navigator.appVersion;

			if (version.substring(0, 1) >= 4) {
				//On calcul la position du milieu de l'écran (selon la taille de la fenêtre
				iPosX = Math.round((screen.availWidth / 2) - (pxWidth / 2))
				iPosY = Math.round((screen.availHeight / 2) - (pxHeigth / 2))
			}
			else {
				//On position à un endroit fixe...
				intPosX = 100
				intPosY = 100
			}
			//Pour l'instant on va juste activer le lightbox sur Chrome iOS
			//	Afin de l'activer allieurs on a juste a décommenter ce if et tester tous les browsers!
			if (!isSafariOrChromeiOS()) {
				wnd = window.open(strURL, strNom, ',screenx=' + iPosX + ',screeny=' + iPosY + ',left=' + iPosX + ',top=' + iPosY + ',height=' + pxHeigth + ',width=' + pxWidth + ',fullscreen=no,toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=no,scrollbars=no');

				//[B54231] 2014-08-28, Patrick Hamel: Si le browser a l'option popup blocker d'activer wnd peut être null et ça fait une erreur JS.
				//On ne fait pas le focus pour éviter cette erreur et on va gérer l'erreur dans notre page au besoin.
				if(wnd != null)
					wnd.focus();
			} else {
				Utils.Popup.OpenPopup(strURL, pxWidth, null, true, fnCallbackPopupFerme, pxHeigth);
			}


			return wnd;

		}; //OuvrirRecherche_Popup


		self.AssocierTextboxRechercheAvecBouton = function (idTextboxRecherche, idBoutonRecherche) {
			_idBoutonRecherche = idBoutonRecherche;
			$("#" + idTextboxRecherche).keypress(self.TextboxRechercheOnKeyPress);
		}; //AssocierTextboxRechercheAvecBouton


		self.TextboxRechercheOnKeyPress = function (e) {
			if (e.which == 13) {
				$("#" + _idBoutonRecherche).click();
				return false;
			}
		} //TextboxRechercheOnKeyPress

		return self;
	} //window.WebApplication.SelectionIndividu

	function isSafariOrChromeiOS() {
		var userAgent = navigator.userAgent;
		if (userAgent != null) {
			userAgent = userAgent.toLowerCase();
			if ((userAgent.indexOf("ipod") != -1 || userAgent.indexOf("ipad") != -1 || userAgent.indexOf("iphone") != -1) && (userAgent.indexOf("crios") != -1 || userAgent.indexOf('safari') != -1 || userAgent.indexOf('mobile') != -1)) {
				return true;
			}
		}
		return false;
	}
})();
