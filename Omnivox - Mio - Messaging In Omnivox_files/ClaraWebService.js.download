/**
 * Fonction javascript accessible pour les onclick qui permet d'ouvrir Clara au sommaire de l'étudiant via son Numéro de DA.
 * @param {string} noDa - Le numéro de DA pour lequel on veut ouvrir Clara
 * @param {Element} el - Élément qui a trigger le click.
 */

(function () {

	if (typeof Skytech === 'undefined') Skytech = {};
	if (typeof Skytech.WebService === 'undefined') Skytech.WebService = {};
	if (typeof Skytech.WebService.Clara === 'undefined') Skytech.WebService.Clara = {};

	Skytech.WebService.Clara.init = init;
	Skytech.WebService.Clara.ouvrirClara = ouvrirClara;

	var _ajaxErrorMsg;

	function init(serverVariables) {
		_ajaxErrorMsg = serverVariables.ajaxErrorMsg;
	}

	function ouvrirClara(noDa, el) {
		var currentEl = el;
		currentEl.classList.add('isOpeningClara');

		$.ajax({
			url: "/WebApplication/Module.MIOP/Clara/ClaraWebService.asmx/GetUrlClara",
			type: "POST",
			data: JSON.stringify({ NumeroIndividu: noDa }),
			contentType: "application/json",
			cache: false,
			success: function (response) {
				var data = JSON.parse(response.d);
				currentEl.classList.remove('isOpeningClara');

				if (data.IsSuccess === true) {
					window.location = data.UrlClara;
				} else {
					alert(data.ErrorMsg)
				}
			},
			error: function (response) {
				currentEl.classList.remove('isOpeningClara');
				alert(_ajaxErrorMsg)
			}
		});
	}

})();
