function RetirerImageDuMIO(editor) {
	var isRetireImage = false;

	$('#' + editor.get_id() + '_contentIframe').contents().find('img').each(
		function () {
			// On va vérifier le src de l'image. Si c'est une émoticone, on la garde, sinon, on la supprime
			var src = $.trim($(this).attr('src'));

			if (src.length > 0) {
				if (src.indexOf('/images/General/Emoticons/RadEditor/') == -1 && src.indexOf(';base64,') == -1 && src.indexOf('ReadImageAttachement.ashx') == -1) {
					// C'est une image, et pas un emoticone, on supprime!
					$(this).remove();
					isRetireImage = true;
				}
				else if (src.indexOf('/images/General/Emoticons/RadEditor/') > 0) {
					// C'est un émoticon, mais il y a le nom de domaine... On va retirer cette partie
					$(this).attr('src', src.substring(src.indexOf('/images/General/Emoticons/RadEditor/'), src.length));
				}
			}
			// Sinon, rien à faire, c'est un emoticon valide.
		}
	);

	return isRetireImage;
}

//Méthodes pour les RadEditors
function OnClientCommandExecuting(editor, args) {
	var name = args.get_name(); //The command name
    var val = args.get_value(); //The tool that initiated the command
    if (name == "Emoticons") {
        editor.getToolByName("Emoticons").set_selectedIndex(-1);
        //Paste the selected in the dropdown emoticon    
        editor.pasteHtml("<img src='" + val + "'>");

        //Cancel the further execution of the command
        args.set_cancel(true);
    }       
	
	//[F14053] LÉA - .NET 3.5 et remplacement Télérik
	//Garder le background color on pour firefox lorsqu'on le click sans rien selecter
	var commandName = args.get_commandName();
	if(commandName == "BackColor") {
		if($telerik.isFirefox) {
			var color = args.get_value();
			var editDocument = editor.get_document();
			editor.setFocus();
			editDocument.execCommand('usecss', false, false);
			result = editDocument.execCommand('hilitecolor', false, color);
			args.set_cancel(true);
		}
	}
	else if (commandName == "ImageManager" || commandName == "Unlink" || commandName == "LinkManager") {
	    args.set_cancel(true);
	}
}
function OnClientLoad(editor, args) {
    DeclancheAttenteAutoSave(editor);
    GetTextTelerik(editor);
}
