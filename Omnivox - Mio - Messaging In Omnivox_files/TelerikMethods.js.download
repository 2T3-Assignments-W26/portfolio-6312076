function OnClientPasteHtml(editor, args) {
	//[F14053] LÉA - .NET 3.4 et remplacement Télérik
	//Afin de ne pas avoir 2 fois plus d'espaces quand on paste à partir de word
	var htmlModifie;
	//[B42743] problème important avec MIO - lignes vides ajoutées
	//welp, le bug se produit aussi sous ie10, there we go.
	if (getInternetExplorerVersion() >= 9) {
		htmlModifie = editor.get_html();
		htmlModifie = htmlModifie.replace("<p> </p>", "");
		editor.set_html(htmlModifie);
	}
	//[B30723] CBA : Communauté - plusieurs problèmes
	//On enleve les liens inutiles car il se pourrait qu'on applique un style sur ces liens plus tard dans les pages et on préfère que les 2 soient identiques
	//On fait le change uniquement sur le args.value, CAD ce qui va etre pasté
	htmlModifie = args.value;

	if (htmlModifie == "args.value")
		return;

	var htmlJQuery = $("<div>" + htmlModifie + "</div>");
	$('a:not([href])', htmlJQuery).contents().unwrap();

	args.set_value(htmlJQuery.html());
}

/// 2017-03-08 [B77910] 
/// On va retirer les ManageLien() dans les MIO. Ça ne peut pas fonctionner quand c'est dans un href.
function OnClientPaste_ValidLinks(editor, args) {
	var htmlModifie = args.value;

	if (htmlModifie == "args.value") {
		return;
	}

	htmlModifie = RetirerManageLien(htmlModifie);
	if (htmlModifie !== '') {
		args.set_value(htmlModifie);
	}
}

/// 2017-03-08 [B77910] 
/// On va retirer les ManageLien() dans les MIO. Ça ne peut pas fonctionner quand c'est dans un href, on va donc le remplacer par le lien qui se trouvait passer en paramètre de cette fonction.
/// ex. <a target="_blank" href="https://vaniercollege.omnivox.ca/WebApplication/Module.MIOP/Commun/Message/Skytech.Commun.Application.ManageLien('http%3A%2F%2Fwww.vaniercollege.qc.ca%2Ftlc%2Fworkshops%2Fpractice-english-exit-exam%2F','url',null)">
///    va donner: <a target="_blank" href="http://www.vaniercollege.qc.ca/tlc/workshops/practice-english-exit-exam/">
function RetirerManageLien(htmlModifie) {
	var htmlJQuery = $("<div>" + htmlModifie + "</div>");

	var arrLienErreur = $('a', htmlJQuery).filter(function (index) {
		if ($(this).attr('href'))
			return $(this).attr('href').toLowerCase().indexOf('skytech.commun.application.managelien') > 0;
		else
			return false;
	});

	if (arrLienErreur.length > 0) {
		$(arrLienErreur).each(function () {
			var hrefLien = decodeURI($(this).attr('href'));

			// On va rechercher la position de ManageLien() pour aller chercher le lien.
			var stringRechDebut = 'managelien(\'';
			var indDebut = hrefLien.toLowerCase().indexOf(stringRechDebut) + stringRechDebut.length;
			var indFin = hrefLien.toLowerCase().indexOf('\'', indDebut + 1);

			// Si on connaît la position de début et de fin, on va pouvoir faire un substring. Sinon, on laisse ça telquelle. 
			if (indFin !== -1) {
				var nouvLien = hrefLien.substring(indDebut, indFin);
				nouvLien = decodeURIComponent(nouvLien);

				$(this).attr('href', nouvLien);
			}			
		});

		return htmlJQuery.html();
	}

	return '';
}


//Obtenu sur le site de MSDN, retourne -1 si c'est un autre browser, et un nombre pour la version d'IE
function getInternetExplorerVersion()
// Returns the version of Internet Explorer or a -1
// (indicating the use of another browser).
{
	var rv = -1; // Return value assumes failure.
	if (navigator.appName == 'Microsoft Internet Explorer') {
		var ua = navigator.userAgent;
		var re = new RegExp("MSIE ([0-9]{1,}[\.0-9]{0,})");
		if (re.exec(ua) != null)
			rv = parseFloat(RegExp.$1);
	}
	return rv;
}

//Mathieu 2013-05-02 [B43491] Certains navigateurs ne supporte pas le OnPasteEvent et ne feront pas de vérification pour enlever les tags que Word ajoute. On va donc faire un OnClientSubmit au submit ce qui
//							  va enlever ces caractères/<!--...
function OnClientSubmit(editor)
{
	var isBrowserSupporte = true;
	
	// Certains navigateurs ne supportent pas le OnPaste Event. On va donc stripper (ce que Word ajoute quand on paste le texte) au submit puisque ça n'aurras pas été fait.
	if (navigator != null) {
		if (navigator.userAgent.indexOf("Opera") > -1) {
			isBrowserSupporte = false;
		}
	}
		
	if (!isBrowserSupporte) {
		editor.fire("FormatStripper", {value : "WORD"}); // Valeur possible: ALL, ALL_NO_BRAKES, CSS, SPAN, FONT, WORD, WORD_ALL and WORD_NO_FONTS.
	}

	// Mathieu 2013-05-09 [B43849] On va aussi parcourir tout les liens. S'il n'on pas de target, on va en mettre un.
	var docEditor = editor.get_document();

	var liens = docEditor.getElementsByTagName("a");

	for (var indLien = 0; indLien < liens.length; indLien++) {
		if (!liens[indLien].getAttribute('target')) {
			liens[indLien].setAttribute('target', '_blank');
		}
	}

	// Mathieu 2013-01-15 [B49216] Dans les MIO, on se retrouve avec un caractère unicode (&#8203; -> zero-width space symbol). Telerik a ajouté ce caractère pour la raison suivante:
	//		«The zero-width space symbol is used in the Editor in order to work around browser issues in the Chrome browser concerning the selection of empty nodes. That is the reason 
	//		 why the ZWSP is used when using the font size with an empty selection.»
	//		Avoir ce caractère dans le code html déclanche le request validation. Avant de faire le POST de la page, on va retirer ce caractère (8203 devient 200B en hexadécimal).
	var htmlModifie;
	htmlModifie = editor.get_html();

	// On va remplacer le html uniquement si le caractère est présent.
	if (htmlModifie.indexOf('\u200B') >= 0) {
		htmlModifie = htmlModifie.replace(/\u200B/g, '');
		editor.set_html(htmlModifie);
	}

	return false;
}